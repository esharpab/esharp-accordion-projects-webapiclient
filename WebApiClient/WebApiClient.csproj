<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccordionQ2.WebApiClient</RootNamespace>
    <AssemblyName>AccordionQ2.WebApiClient</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>AccordionQ2.WebApiClient</PackageId>
    <Version>7.0.0</Version>
    <Authors>E-Sharp AB</Authors>
    <Company>E-Sharp AB</Company>
    <Description>HTTP client library for the AccordionQ2 Hardware Management REST API.</Description>
    <PackageTags>accordion;webapi;client;hardware</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>7.0.0: station API keys (X-Api-Key), pinned HTTPS certificates and IPv6 base URLs. Source compatible with 5.x for normal use and needs a rebuild (not binary compatible); without a key or pin it sends what 5.28 sent, and it works with firmware 6.x and 7. Breaks: new AccordionQ2Client(url, null) no longer compiles; ApiGroupBase can't be derived from; a caller's HttpClient no longer gets BaseAddress set; redirects aren't followed. Full list: https://github.com/esharpab/esharp-accordion-projects-webapiclient/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/esharpab/esharp-accordion-projects-webapiclient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/esharpab/esharp-accordion-projects-webapiclient.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebApiClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
