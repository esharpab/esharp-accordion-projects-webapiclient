<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccordionQ2.WebApiClient</RootNamespace>
    <AssemblyName>AccordionQ2.WebApiClient</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>AccordionQ2.WebApiClient</PackageId>
    <Version>7.3.0</Version>
    <Authors>E-Sharp AB</Authors>
    <Company>E-Sharp AB</Company>
    <Description>HTTP client library for the AccordionQ2 Hardware Management REST API.</Description>
    <PackageTags>accordion;webapi;client;hardware</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>7.3.0: stable module names: Modules.GetPresentAsync (the modules present, hardware and software), client.JtagPorts (the JTAG ports, their state and XVC switch), DrummerTarget.GetPortAsync and BindPortAsync, CapabilitiesDto.Names. 7.2.0: client.Drummer: find the Drummer modules (FPGA instruments over JTAG) and run their operations (Target(prefix).CallAsync("MEM", "mem_start", args)) as transactions on their Call channels, following long ones as jobs; status, info, attention, jobs, snapshots, field and semantic channels. Needs firmware with the resources.transact capability; otherwise the same as 7.1.0: https://github.com/esharpab/esharp-accordion-projects-webapiclient/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/esharpab/esharp-accordion-projects-webapiclient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/esharpab/esharp-accordion-projects-webapiclient.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebApiClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
